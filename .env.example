# ==========================================
# Ultroid-Neo Configuration Environment (.env)
# ==========================================

# --- Telegram API Credentials ---
# Obtain from https://my.telegram.org/apps
API_ID=1234567
API_HASH=your_api_hash_here

# --- MTProto User Session ---
# Safe String Session (generated in Phase 7 with session_generator.py)
STRING_SESSION=

# --- Assistant Bot API Token (Optional but Recommended) ---
# Create a bot via @BotFather on Telegram for inline help menus & interactive alerts
BOT_TOKEN=

# --- Dynamic AI Engine (Groq Multi-Key Pool) ---
# Comma-separated list of your Groq API keys (can be 1, 4, 10, or more)
# Additional keys can also be added dynamically inside Telegram with .addkey groq <key>
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3,gsk_key4
DEFAULT_AI_MODEL=llama-3.3-70b-versatile
DEFAULT_WHISPER_MODEL=whisper-large-v3

# --- Command & Bot Customization ---
COMMAND_PREFIX=.
DATABASE_PATH=data/ultroid_neo.db

# --- Optional Dedicated Log / Forum Chat ---
# Can be your own Saved Messages (default: "me") or a private supergroup/channel ID
LOG_CHAT_ID=me

# --- 24/7 Forever-Free PaaS Keep-Alive ---
# Set by platforms like Render/Koyeb/Hugging Face automatically. If set, a micro-health server starts.
PORT=8080

# --- The Guardian Anti-Ban Shield Settings ---
ANTI_BAN_GUARD=true
FLOOD_WAIT_CIRCUIT_BREAKER_SECS=60
THROTTLE_PROGRESS_INTERVAL_SECS=3.5
HUMAN_JITTER_MIN_MS=150
HUMAN_JITTER_MAX_MS=450
