[Unit]
Description=NovaCore Telegram Automation Engine Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/novacore-engine
ExecStart=/root/novacore-engine/.venv/bin/python main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
